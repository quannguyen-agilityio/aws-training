{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Amplify Gen 1 Cognito User Pool Stack",
  "Parameters": {
    "env": {
      "Type": "String"
    },
    "userPoolName": {
      "Type": "String",
      "Default": "ApexAthletes-UserPool"
    },
    "autoVerifiedAttributes": {
      "Type": "CommaDelimitedList",
      "Default": "email"
    },
    "requiredAttributes": {
      "Type": "CommaDelimitedList",
      "Default": "email"
    },
    "passwordPolicyMinLength": {
      "Type": "Number",
      "Default": 8
    }
  },
  "Resources": {
    "UserPool": {
      "Type": "AWS::Cognito::UserPool",
      "Properties": {
        "UserPoolName": {
          "Fn::Sub": "${userPoolName}-${env}"
        },
        "AutoVerifiedAttributes": {
          "Ref": "autoVerifiedAttributes"
        },
        "UsernameAttributes": ["email"],
        "Policies": {
          "PasswordPolicy": {
            "MinimumLength": {
              "Ref": "passwordPolicyMinLength"
            },
            "RequireLowercase": false,
            "RequireNumbers": false,
            "RequireSymbols": false,
            "RequireUppercase": false
          }
        },
        "Schema": [
          {
            "Name": "email",
            "AttributeDataType": "String",
            "Required": true,
            "Mutable": true
          }
        ],
        "VerificationMessageTemplate": {
          "DefaultEmailOption": "CONFIRM_WITH_CODE",
          "EmailSubject": "Your verification code",
          "EmailMessage": "Your verification code is {####}"
        }
      }
    },
    "UserPoolClient": {
      "Type": "AWS::Cognito::UserPoolClient",
      "Properties": {
        "ClientName": {
          "Fn::Sub": "ApexAuthClient-${env}"
        },
        "UserPoolId": {
          "Ref": "UserPool"
        },
        "GenerateSecret": false,
        "RefreshTokenValidity": 30,
        "ExplicitAuthFlows": [
          "ALLOW_USER_SRP_AUTH",
          "ALLOW_REFRESH_TOKEN_AUTH",
          "ALLOW_USER_PASSWORD_AUTH"
        ],
        "WriteAttributes": ["email"],
        "ReadAttributes": ["email"]
      }
    },
    "AdminGroup": {
      "Type": "AWS::Cognito::UserPoolGroup",
      "Properties": {
        "GroupName": "AdminGroup",
        "Description": "Administrator group for ApexAthletes",
        "UserPoolId": {
          "Ref": "UserPool"
        }
      }
    },
    "UserPoolIdSSMParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/awstraining/${env}/VITE_USER_POOL_ID"
        },
        "Type": "String",
        "Value": {
          "Ref": "UserPool"
        },
        "Description": "Cognito User Pool ID for Frontend"
      }
    },
    "AppClientIdSSMParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/awstraining/${env}/VITE_USER_POOL_CLIENT_ID"
        },
        "Type": "String",
        "Value": {
          "Ref": "UserPoolClient"
        },
        "Description": "Cognito User Pool Client ID for Frontend"
      }
    },
    "RegionSSMParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/awstraining/${env}/VITE_AWS_REGION"
        },
        "Type": "String",
        "Value": {
          "Ref": "AWS::Region"
        },
        "Description": "AWS Region for Frontend"
      }
    }
  },
  "Outputs": {
    "UserPoolId": {
      "Value": {
        "Ref": "UserPool"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-UserPoolId"
        }
      }
    },
    "UserPoolArn": {
      "Value": {
        "Fn::GetAtt": ["UserPool", "Arn"]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-UserPoolArn"
        }
      }
    },
    "AppClientID": {
      "Value": {
        "Ref": "UserPoolClient"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-AppClientID"
        }
      }
    }
  }
}

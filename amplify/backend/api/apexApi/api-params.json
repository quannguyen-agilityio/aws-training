{
  "apiName": "apexApi",
  "privacy": {
    "open": true
  },
  "resourceName": "apexApi",
  "paths": [
    {
      "name": "/players",
      "lambdaFunction": "producer",
      "privacy": {
        "open": true
      }
    },
    {
      "name": "/players/{playerId}",
      "lambdaFunction": "producer",
      "privacy": {
        "protected": true,
        "auth": {
          "userPoolId": "apexAuth"
        }
      }
    }
  ],
  "dependsOn": [
    {
      "category": "auth",
      "resourceName": "apexAuth",
      "attributes": ["UserPoolId"]
    }
  ]
}

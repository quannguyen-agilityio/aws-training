{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Amplify Gen 1 API Gateway Stack for apexApi",
  "Parameters": {
    "env": {
      "Type": "String"
    },
    "authapexAuthUserPoolId": {
      "Type": "String",
      "Description": "Cognito User Pool ID from apexAuth"
    }
  },
  "Resources": {
    "RestApi": {
      "Type": "AWS::ApiGateway::RestApi",
      "Properties": {
        "Name": {
          "Fn::Sub": "apexApi-${env}"
        },
        "Description": "REST API Gateway for ApexAthletes application",
        "EndpointConfiguration": {
          "Types": ["REGIONAL"]
        }
      }
    },
    "CognitoAuthorizer": {
      "Type": "AWS::ApiGateway::Authorizer",
      "Properties": {
        "Name": "CognitoUserPoolAuthorizer",
        "Type": "COGNITO_USER_POOLS",
        "RestApiId": {
          "Ref": "RestApi"
        },
        "IdentitySource": "method.request.header.Authorization",
        "ProviderARNs": [
          {
            "Fn::Sub": "arn:aws:cognito-idp:${AWS::Region}:${AWS::AccountId}:userpool/${authapexAuthUserPoolId}"
          }
        ]
      }
    },
    "PlayersResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Fn::GetAtt": ["RestApi", "RootResourceId"]
        },
        "PathPart": "players"
      }
    },
    "PlayerIdResource": {
      "Type": "AWS::ApiGateway::Resource",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ParentId": {
          "Ref": "PlayersResource"
        },
        "PathPart": "{playerId}"
      }
    },
    "PlayersOptionsMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ResourceId": {
          "Ref": "PlayersResource"
        },
        "HttpMethod": "OPTIONS",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "MOCK",
          "IntegrationResponses": [
            {
              "StatusCode": "200",
              "ResponseParameters": {
                "method.response.header.Access-Control-Allow-Headers": "'Content-Type,X-Amz-Date,Authorization,X-Api-Key,X-Amz-Security-Token'",
                "method.response.header.Access-Control-Allow-Methods": "'GET,POST,DELETE,OPTIONS'",
                "method.response.header.Access-Control-Allow-Origin": "'*'"
              }
            }
          ],
          "RequestTemplates": {
            "application/json": "{\"statusCode\": 200}"
          }
        },
        "MethodResponses": [
          {
            "StatusCode": "200",
            "ResponseParameters": {
              "method.response.header.Access-Control-Allow-Headers": true,
              "method.response.header.Access-Control-Allow-Methods": true,
              "method.response.header.Access-Control-Allow-Origin": true
            }
          }
        ]
      }
    },
    "PlayersGetMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ResourceId": {
          "Ref": "PlayersResource"
        },
        "HttpMethod": "GET",
        "AuthorizationType": "NONE",
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:PlayerOnboardingProducer-${env}/invocations"
          }
        }
      }
    },
    "PlayersPostMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ResourceId": {
          "Ref": "PlayersResource"
        },
        "HttpMethod": "POST",
        "AuthorizationType": "COGNITO_USER_POOLS",
        "AuthorizerId": {
          "Ref": "CognitoAuthorizer"
        },
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:PlayerOnboardingProducer-${env}/invocations"
          }
        }
      }
    },
    "PlayerIdDeleteMethod": {
      "Type": "AWS::ApiGateway::Method",
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "ResourceId": {
          "Ref": "PlayerIdResource"
        },
        "HttpMethod": "DELETE",
        "AuthorizationType": "COGNITO_USER_POOLS",
        "AuthorizerId": {
          "Ref": "CognitoAuthorizer"
        },
        "Integration": {
          "Type": "AWS_PROXY",
          "IntegrationHttpMethod": "POST",
          "Uri": {
            "Fn::Sub": "arn:aws:apigateway:${AWS::Region}:lambda:path/2015-03-31/functions/arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:PlayerOnboardingProducer-${env}/invocations"
          }
        }
      }
    },
    "ApiDeployment": {
      "Type": "AWS::ApiGateway::Deployment",
      "DependsOn": ["PlayersGetMethod", "PlayersPostMethod", "PlayerIdDeleteMethod"],
      "Properties": {
        "RestApiId": {
          "Ref": "RestApi"
        },
        "StageName": {
          "Ref": "env"
        }
      }
    },
    "ApiEndpointSSMParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": {
          "Fn::Sub": "/awstraining/${env}/VITE_API_ENDPOINT"
        },
        "Type": "String",
        "Value": {
          "Fn::Sub": "https://${RestApi}.execute-api.${AWS::Region}.amazonaws.com/${env}"
        },
        "Description": "API Gateway Root URL for Frontend"
      }
    }
  },
  "Outputs": {
    "RootUrl": {
      "Value": {
        "Fn::Sub": "https://${RestApi}.execute-api.${AWS::Region}.amazonaws.com/${env}"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-RootUrl"
        }
      }
    },
    "ApiId": {
      "Value": {
        "Ref": "RestApi"
      }
    }
  }
}

{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Amplify Gen 1 Lambda Stack for Consumer Function (PlayerOnboardingConsumer) with SQS Event Source Mapping",
  "Parameters": {
    "env": {
      "Type": "String"
    }
  },
  "Resources": {
    "ConsumerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "PlayerOnboardingConsumer-${env}"
        },
        "Handler": "index.handler",
        "Runtime": "nodejs24.x",
        "MemorySize": 256,
        "Timeout": 30,
        "Role": {
          "Fn::Sub": "arn:aws:iam::${AWS::AccountId}:role/ConsumerLambdaRole-${env}"
        },
        "Code": {
          "ZipFile": "exports.handler = async (event) => { return { statusCode: 200, body: JSON.stringify({ message: 'Consumer placeholder' }) }; };"
        },
        "Environment": {
          "Variables": {
            "NODE_ENV": {
              "Ref": "env"
            },
            "TABLE_NAME": {
              "Fn::Sub": "ApexPlayers-${env}"
            },
            "SES_SENDER_EMAIL": "noreply@apexathletes.com"
          }
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "env"
            }
          }
        ]
      }
    },
    "SqsEventSourceMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "BatchSize": 10,
        "Enabled": true,
        "EventSourceArn": {
          "Fn::Sub": "arn:aws:sqs:${AWS::Region}:${AWS::AccountId}:PlayerOnboardingQueue-${env}"
        },
        "FunctionName": {
          "Ref": "ConsumerFunction"
        }
      }
    }
  },
  "Outputs": {
    "FunctionName": {
      "Value": {
        "Ref": "ConsumerFunction"
      }
    },
    "FunctionArn": {
      "Value": {
        "Fn::GetAtt": ["ConsumerFunction", "Arn"]
      }
    }
  }
}
